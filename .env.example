# Copy to .env and fill in. Never commit the filled version.

NUXT_DATABASE_URL=postgres://vestigian:vestigian@127.0.0.1:5432/vestigian
NUXT_REDIS_URL=redis://127.0.0.1:6379

# openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-at-least-32-random-characters

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_IMAGE_BASE_URL=http://localhost:8080

# The app menu's "Support this project" donation link is hidden until this is
# set — an operator hasn't picked a destination yet, and a dead link would be
# worse than no link.
NUXT_PUBLIC_DONATE_URL=

# The partners page lists invented example organisations so its layout can be seen.
# `pnpm dev` shows them anyway; a built deployment shows none unless this is true.
NUXT_PUBLIC_SHOW_EXAMPLE_PARTNERS=false

# 'openfreemap' needs no setup and is right for development.
# 'pmtiles' reads a self-hosted extract from object storage — set the URL too.
NUXT_PUBLIC_BASEMAP_PROVIDER=openfreemap
NUXT_PUBLIC_BASEMAP_PMTILES_URL=

# The DARE antiquity sheet. Left unset, every visitor's browser fetches these
# tiles straight from a university research server in Gothenburg — fine for a
# development session, not something to point real traffic at. Run
# `pnpm import:basemap dare` and set this to the mirror.
#   e.g. https://vestigian.b-cdn.net/basemap/dare/{z}/{x}/{y}.png
NUXT_PUBLIC_BASEMAP_ANTIQUITY_DARE_URL=
# The satellite view (Sentinel-2 cloudless, EOX IT Services GmbH, Vienna).
# Left unset, every visitor's browser fetches these tiles straight from EOX's
# own tile server — fine for development, not for real traffic. Run
# `pnpm import:basemap satellite` and set this to the mirror.
#   e.g. https://vestigian.b-cdn.net/basemap/satellite/{z}/{x}/{y}.jpg
NUXT_PUBLIC_BASEMAP_SATELLITE_URL=
# The other antiquity sheet is served by this app from its own PostGIS
# (`pnpm import:atlas`), and so is the frontier drawn over it when "Follow the
# limes" is switched on (`pnpm import:limes`) — neither needs a third-party
# origin or a mirror.

# The Tabula Peutingeriana network overlay (places and roads from the
# manuscript, drawn at real coordinates over any basemap). `pnpm
# import:tabula-peutingeriana` populates it. René Voorburg (omnesviae.org), who
# compiled the data, confirmed reuse; the dataset states no licence of its own.
# `false` takes the layer down (the endpoint 404s and the toggle disappears).
NUXT_PUBLIC_TABULA_PEUTINGERIANA_ENABLED=true

# Elevation, for the hillshade under the Barrington sheet. A single PMTiles
# archive on the CDN (`pmtiles://https://…/terrain.pmtiles` or the bare https
# URL, made by `scripts/ops/mirror-terrain.sh`) or a `{z}/{x}/{y}` template.
# Left empty, development falls back to Mapterhorn's public tiles while a
# production build draws NO relief — the public host is Cloudflare, and the CSP
# does not allow it in production. In production set `TERRAIN_URL` (compose
# passes it on). A host other than the CDN must be added to `mapAssetOrigins`
# in `nuxt.config.ts` or the browser refuses it silently.
# NUXT_PUBLIC_BASEMAP_TERRAIN_URL=

# openssl rand -hex 32, twice
NUXT_IMGPROXY_KEY=
NUXT_IMGPROXY_SALT=
NUXT_IMGPROXY_BASE_URL=http://localhost:8080


# Object storage: MinIO locally, Bunny Edge Storage in production.
NUXT_STORAGE_ENDPOINT=http://127.0.0.1:9000
NUXT_STORAGE_BUCKET=vestigian
NUXT_STORAGE_ACCESS_KEY_ID=vestigian
NUXT_STORAGE_SECRET_ACCESS_KEY=vestigian-dev-secret

# Only needed if NUXT_STORAGE_ENDPOINT above is pointed at a real bucket
# instead of the local MinIO container (e.g. to see real photographs in dev).
# docker/compose.dev.yml's imgproxy service runs inside the compose network
# and cannot reach NUXT_STORAGE_ENDPOINT's host-facing 127.0.0.1 address, so
# it needs its own copy of the real endpoint — credentials are already shared
# with NUXT_STORAGE_ACCESS_KEY_ID/SECRET_ACCESS_KEY above.
# IMGPROXY_STORAGE_ENDPOINT=https://de-s3.storage.bunnycdn.com

# Transactional mail: a Brevo (EU) API key, for the app's own HTTP API calls.
# Alerts (production only) go over Discord instead of mail — DISCORD_WEBHOOK_URL,
# see docker/compose.prod.yml and docker/observability/alertmanager.yml —
# deliberately not email, so no personal address sits in that public file.
# Left empty in development, mail goes to Mailpit — http://localhost:8025 —
# which `pnpm stack:up` already starts, and to the log if that is not running.
NUXT_MAIL_API_KEY=
NUXT_MAIL_FROM=Vestigian <no-reply@vestigian.example>

# Only needed while running the import scripts.
MYSQL_URL=mysql://root:root@127.0.0.1:3307/vici

# Self-hosted LibreTranslate (docker/compose.dev.yml). Empty disables translation.
NUXT_TRANSLATE_URL=http://127.0.0.1:5050/translate
NUXT_TRANSLATE_TARGET=en

# HMAC secret for the ALTCHA signup challenge. Empty means signup refuses.
NUXT_ALTCHA_SECRET=generate-with-openssl-rand-hex-32
# AES-256-GCM key for opt-in two-factor login (server/utils/totp.ts). Unlike
# every other secret above, this one is reversible by design — the stored
# TOTP secret has to be decrypted to check a live code — so losing or
# rotating it makes every enrolled user's stored secret permanently
# unverifiable (their own backup codes, or an admin clearing the two columns
# directly in Postgres, are the only way back in). Empty means enrollment
# refuses.
# openssl rand -hex 32
NUXT_TOTP_ENCRYPTION_KEY=
# Believe x-real-ip. Only true behind a CDN you control AND an origin firewall
# that refuses everything else — without the firewall this makes every rate
# limit forgeable by anyone who finds the origin address.
NUXT_BEHIND_TRUSTED_PROXY=false

# Telemetry. Empty endpoint disables tracing entirely — the collector is
# optional infrastructure and the app serves without it. Point at the dev Alloy
# (`pnpm stack:observability`) or straight at Tempo; both speak OTLP.
NUXT_TELEMETRY_OTLP_ENDPOINT=
NUXT_TELEMETRY_LOG_LEVEL=debug

# Off-box backups (production only — read by docker/compose.prod.yml's `backup`
# service, never by the app). Leave empty and the nightly dump still runs and is
# still kept for fourteen days; it simply never leaves the machine it is a
# backup of, which is the situation these exist to end.
#
# Repository: a directory on netcup Storage Space, mounted over NFS on the VPS
# and bind-mounted into the backup container at /offsite — so the value is
# `/offsite/restic`. See documents/runbook_prod.deployment.md §20.
RESTIC_REPOSITORY=
# The host directory the Storage Space is mounted at (e.g. /mnt/netcup-backup).
RESTIC_OFFSITE_DIR=
# restic encrypts client-side, so this passphrase IS the backup. Lose it and
# every off-box snapshot is unreadable — there is no recovery path, by design.
# Store it somewhere that is not this VPS and not this repository.
RESTIC_PASSWORD=

