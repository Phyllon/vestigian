# Copy to .env and fill in. Never commit the filled version.

NUXT_DATABASE_URL=postgres://vestigia:vestigia@127.0.0.1:5432/vestigia
NUXT_REDIS_URL=redis://127.0.0.1:6379

# openssl rand -base64 32
NUXT_SESSION_PASSWORD=replace-me-with-at-least-32-random-characters

NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_IMAGE_BASE_URL=http://localhost:8080

# 'openfreemap' needs no setup and is right for development.
# 'pmtiles' reads a self-hosted extract from object storage — set the URL too.
NUXT_PUBLIC_BASEMAP_PROVIDER=openfreemap
NUXT_PUBLIC_BASEMAP_PMTILES_URL=

# openssl rand -hex 32, twice
NUXT_IMGPROXY_KEY=
NUXT_IMGPROXY_SALT=
NUXT_IMGPROXY_BASE_URL=http://localhost:8080


# Object storage: MinIO locally, Bunny Edge Storage in production.
NUXT_STORAGE_ENDPOINT=http://127.0.0.1:9000
NUXT_STORAGE_BUCKET=vestigia
NUXT_STORAGE_ACCESS_KEY_ID=vestigia
NUXT_STORAGE_SECRET_ACCESS_KEY=vestigia-dev-secret

NUXT_MAIL_API_KEY=

# Only needed while running the import scripts.
MYSQL_URL=mysql://root:root@127.0.0.1:3307/vici

# Self-hosted LibreTranslate (docker/compose.dev.yml). Empty disables translation.
NUXT_TRANSLATE_URL=http://127.0.0.1:5050/translate
NUXT_TRANSLATE_TARGET=en

# HMAC secret for the ALTCHA signup challenge. Empty means signup refuses.
NUXT_ALTCHA_SECRET=generate-with-openssl-rand-hex-32
# Believe x-real-ip. Only true behind a CDN you control AND an origin firewall
# that refuses everything else — without the firewall this makes every rate
# limit forgeable by anyone who finds the origin address.
NUXT_BEHIND_TRUSTED_PROXY=false

# Telemetry. Empty endpoint disables tracing entirely — the collector is
# optional infrastructure and the app serves without it. Point at the dev Alloy
# (`pnpm stack:observability`) or straight at Tempo; both speak OTLP.
NUXT_TELEMETRY_OTLP_ENDPOINT=
NUXT_TELEMETRY_LOG_LEVEL=debug
