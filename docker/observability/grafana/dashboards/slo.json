{
  "uid": "vestigian-slo",
  "title": "Vestigian — SLOs & error budget",
  "description": "Availability and latency objectives over 14 days, error budget remaining and burn rate.",
  "tags": ["vestigian", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-14d", "to": "now" },
  "graphTooltip": 1,
  "editable": false,
  "links": [
    {
      "type": "dashboards",
      "title": "Vestigian",
      "tags": ["vestigian"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Objectives",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 3 },
      "options": {
        "mode": "markdown",
        "content": "**Availability** 99.5% of requests not 5xx · **Tile latency** 95% within 250 ms · **API latency** 95% within 1 s. Window: 14 days (Prometheus keeps 15). Budget = the share of requests allowed to miss the objective; \"burn rate 1\" spends it exactly over the window."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Availability",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 3, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Availability (14d)",
      "gridPos": { "x": 0, "y": 4, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (sum(increase(http_requests_total{status=~\"5..\"}[14d])) or vector(0)) / clamp_min(sum(increase(http_requests_total[14d])), 1)",
          "legendFormat": "Availability (14d)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.98,
          "max": 1,
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.99, "color": "orange" },
              { "value": 0.995, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Error budget remaining",
      "gridPos": { "x": 6, "y": 4, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (1 - (1 - (sum(increase(http_requests_total{status=~\"5..\"}[14d])) or vector(0)) / clamp_min(sum(increase(http_requests_total[14d])), 1))) / 0.0050",
          "legendFormat": "Error budget remaining"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 0.25, "color": "orange" },
              { "value": 0.5, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Burn rate (1h)",
      "description": "1 = on pace to spend the budget exactly over 14 days. 14.4 for an hour is the fast-burn page.",
