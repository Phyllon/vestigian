          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(moderation_actions_total{action=\"approved\"}[7d])) / clamp_min(sum(increase(moderation_actions_total{action=~\"approved|rejected\"}[7d])), 1)",
