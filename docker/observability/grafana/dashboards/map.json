      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (zoom) (rate(tile_requests_total{cache=\"miss\"}[$__rate_interval]))",
          "legendFormat": "z{{zoom}}"
