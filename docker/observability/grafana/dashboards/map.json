    {
      "id": 12,
      "type": "timeseries",
      "title": "Render time (PostGIS, misses)",
      "gridPos": { "x": 0, "y": 22, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, strategy) (rate(tile_render_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{strategy}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, strategy) (rate(tile_render_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{strategy}}"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, strategy) (rate(tile_render_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{strategy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
