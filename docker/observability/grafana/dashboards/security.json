{
  "uid": "vestigian-security",
  "title": "Vestigian — security & abuse",
  "description": "Sign-in outcomes, rate-limit decisions, refused requests, privileged actions and the audit trail.",
  "tags": ["vestigian", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "graphTooltip": 1,
  "editable": false,
  "links": [
    {
      "type": "dashboards",
      "title": "Vestigian",
      "tags": ["vestigian"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is protection actually on?",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Rate limiter FAILED OPEN (1h)",
      "description": "Non-zero: Valkey was unreachable and every limit was absent for that time.",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rate_limit_decisions_total{outcome=\"failed_open\"}[1h])) or vector(0)",
          "legendFormat": "Rate limiter FAILED OPEN (1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1, "color": "orange" },
              { "value": 1, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Valkey up",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "redis_up",
          "legendFormat": "Valkey up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "orange" },
              { "value": 1, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests refused (429), 1h",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(http_requests_total{status=\"429\"}[1h])) or vector(0)",
          "legendFormat": "Requests refused (429), 1h"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Share of requests rate-limited",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(rate(rate_limit_decisions_total{outcome=\"blocked\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(rate_limit_decisions_total[$__rate_interval])), 0.001)",
          "legendFormat": "Share of requests rate-limited"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Detection and edge enforcement (CrowdSec → Bunny)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "CrowdSec reachable",
      "description": "Zero: Prometheus cannot scrape CrowdSec, so nothing below is current.",
      "gridPos": { "x": 0, "y": 7, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(up{job=\"crowdsec\"}) or vector(0)",
          "legendFormat": "CrowdSec reachable"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "orange" },
              { "value": 1, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Bouncer heartbeat (30 min)",
      "description": "The bouncer reconciles with Bunny every 10 minutes and logs it. Zero: it is stopped or stuck, and bans are no longer reaching the edge.",
      "gridPos": { "x": 4, "y": 7, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"bunny-bouncer\"} |= \"reconciled with Bunny\" [30m])) or vector(0)",
          "legendFormat": "Bouncer heartbeat (30 min)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "orange" },
              { "value": 1, "color": "green" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Entries on Bunny (cap 100)",
      "description": "Bunny refuses the 101st blocked IP. Past the cap, bans are logged as not enforced at the edge.",
      "gridPos": { "x": 8, "y": 7, "w": 4, "h": 5 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "max(last_over_time({service=\"bunny-bouncer\"} |= \"reconciled with Bunny\" | json | unwrap blockedOnBunny [30m]))",
          "legendFormat": "Entries on Bunny (cap 100)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 70, "color": "orange" },
              { "value": 95, "color": "red" }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Standing local bans",
      "description": "Decisions this deployment made itself: the only ones mirrored to Bunny.",
      "gridPos": { "x": 12, "y": 7, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(cs_active_decisions{origin=~\"crowdsec|cscli\"}) or vector(0)",
          "legendFormat": "Standing local bans"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Community decisions held",
      "description": "Downloaded from CrowdSec; deliberately not mirrored (Bunny holds 100).",
      "gridPos": { "x": 16, "y": 7, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(cs_active_decisions{origin!~\"crowdsec|cscli\"}) or vector(0)",
          "legendFormat": "Community decisions held"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Alerts raised (24h)",
      "gridPos": { "x": 20, "y": 7, "w": 4, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(cs_alerts[24h])) or vector(0)",
          "legendFormat": "Alerts raised (24h)"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Standing bans by origin",
      "description": "Falls as bans expire; a staircase up is an attack in progress.",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (origin, action) (cs_active_decisions)",
          "legendFormat": "{{origin}} · {{action}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Alerts by scenario in range",
      "description": "Which detection fires: a local scenario (vestigian/…) or a hub one (Traefik, AppSec).",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sort_desc(sum by (reason) (increase(cs_alerts[$__range])))",
          "legendFormat": "{{reason}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "valueMode": "color"
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "What the bouncer did at the edge",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"bunny-bouncer\"} |= \"blocked at Bunny\" [$__interval]))",
          "legendFormat": "blocked"
        },
        {
          "refId": "B",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"bunny-bouncer\"} |= \"unblocked at Bunny\" [$__interval]))",
          "legendFormat": "unblocked (ban expired)"
        },
        {
          "refId": "C",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"bunny-bouncer\"} |= \"list is full\" [$__interval]))",
          "legendFormat": "list full, not enforced"
        },
        {
          "refId": "D",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"bunny-bouncer\"} |= \"refused one address\" [$__interval]))",
          "legendFormat": "Bunny refused an address"
        },
        {
          "refId": "E",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(count_over_time({service=\"bunny-bouncer\"} |= \"cycle failed\" [$__interval]))",
          "legendFormat": "cycle failed (Bunny/LAPI error)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "blocked" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unblocked (ban expired)" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "list full, not enforced" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "Bunny refused an address" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "cycle failed (Bunny/LAPI error)" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 16,
      "type": "row",
      "title": "Sign-in and accounts",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 28, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Sign-in outcomes",
      "gridPos": { "x": 0, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (increase(auth_events_total{event=\"login\"}[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "accepted" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "rejected" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "blocked" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unverified" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 18,
      "type": "timeseries",
      "title": "Sign-in failure ratio",
      "description": "A sustained jump with a flat attempt count is credential stuffing; a jump in attempts too is a brute-force run.",
      "gridPos": { "x": 12, "y": 29, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(sum(increase(auth_events_total{event=\"login\",outcome=~\"rejected|blocked\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(increase(auth_events_total{event=\"login\"}[$__rate_interval])), 0.001)",
          "legendFormat": "failed / attempts"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "Registrations",
      "description": "Four sign-ups an hour per address is the limit; ALTCHA + honeypot sit before it.",
      "gridPos": { "x": 0, "y": 37, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(auth_events_total{event=\"register\",outcome=\"accepted\"}[$__rate_interval]))",
          "legendFormat": "accepted"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rate_limit_decisions_total{policy=\"register\",outcome=\"blocked\"}[$__rate_interval]))",
          "legendFormat": "rate-limited"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rate_limit_decisions_total{policy=\"challenge\",outcome=\"blocked\"}[$__rate_interval]))",
          "legendFormat": "challenge refused"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Lockouts: people who hit a limit",
      "description": "Each is a 429 shown to someone. A real person mistyping looks like one or two; a run of them is a script.",
      "gridPos": { "x": 12, "y": 37, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rate_limit_decisions_total{policy=\"login\",outcome=\"blocked\"}[$__rate_interval]))",
          "legendFormat": "sign-in (8 per 15 min)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rate_limit_decisions_total{policy=\"twoFactorVerify\",outcome=\"blocked\"}[$__rate_interval]))",
          "legendFormat": "second factor"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(rate_limit_decisions_total{policy=\"adminStepUp\",outcome=\"blocked\"}[$__rate_interval]))",
          "legendFormat": "admin step-up"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "mode": "none", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Second factor and password recovery",
