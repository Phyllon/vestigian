    {
      "id": 23,
      "type": "row",
      "title": "Audit trail and attack detection (logs)",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 54, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "id": 24,
      "type": "logs",
      "title": "Audit events",
      "description": "Governance and authentication events, newest first.",
      "gridPos": { "x": 0, "y": 55, "w": 24, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service=\"app\", audit!=\"\"} | json | line_format \"{{.audit}} · {{.msg}}\""
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      }
    },
    {
