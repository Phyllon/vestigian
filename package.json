{
  "name": "vestigia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nuxt dev --host",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "check": "concurrently -g -c blue,magenta,green,yellow \"pnpm:lint\" \"pnpm:typecheck\" \"pnpm:test\" \"pnpm:format:check\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:snapshot": "tsx --env-file-if-exists=.env scripts/snapshot-database.ts",
    "import:fetch": "tsx --env-file-if-exists=.env scripts/import/01-fetch-dump.ts",
    "import:convert": "tsx --env-file-if-exists=.env scripts/import/02-mysql-to-postgres.ts",
    "import:image-records": "tsx --env-file-if-exists=.env scripts/import/02b-image-records.ts",
    "import:images": "tsx --env-file-if-exists=.env scripts/import/03-mirror-images.ts",
    "stack:up": "docker compose -f docker/compose.dev.yml up -d",
    "stack:down": "docker compose -f docker/compose.dev.yml down",
    "stack:logs": "docker compose -f docker/compose.dev.yml logs -f",
    "stack:observability": "docker compose -f docker/compose.dev.yml --profile observability up -d",
    "stack:observability:down": "docker compose -f docker/compose.dev.yml --profile observability down",
    "images:reconcile": "tsx --env-file-if-exists=.env scripts/reconcile-images.ts",
    "import:basemap": "tsx --env-file-if-exists=.env scripts/import/04-mirror-basemap-tiles.ts",
    "import:atlas": "tsx --env-file-if-exists=.env scripts/import/05-antiquity-atlas.ts",
    "import:limes": "tsx --env-file-if-exists=.env scripts/import/06-limes.ts",
    "glyphs:build": "tsx scripts/build-glyphs.ts",
    "og:build": "tsx scripts/generate-og-placeholders.ts",
    "icons:build": "tsx scripts/generate-app-icons.ts",
    "tiles:warm": "tsx --env-file-if-exists=.env scripts/warm-tiles.ts",
    "i18n:translate": "tsx --env-file-if-exists=.env scripts/i18n/translate-locales.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prometheus-io/client": "^0.16.1",
    "@vueuse/core": "13.9.0",
    "altcha": "^3.2.2",
    "altcha-lib": "^2.3.2",
    "drizzle-orm": "^0.36.4",
    "ioredis": "^5.4.1",
    "maplibre-gl": "^5.0.0",
    "nuxt": "^4.0.0",
    "pino": "^10.3.1",
    "pmtiles": "^4.1.0",
    "postgres": "^3.4.5",
    "sharp": "^0.33.5",
    "terra-draw": "^1.0.0",
    "terra-draw-maplibre-gl-adapter": "^1.0.0",
    "translate": "^3.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.125",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^3.15.1",
    "@nuxt/ui": "^3.0.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/nuxt": "^13.9.0",
    "concurrently": "^10.0.5",
    "csv-parse": "^7.0.2",
    "drizzle-kit": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fontnik": "^0.7.7",
    "happy-dom": "^15.11.7",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "mysql2": "^3.11.5",
    "nuxt-auth-utils": "^0.5.7",
    "nuxt-security": "^2.1.5",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.1.10",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1"
  }
}
