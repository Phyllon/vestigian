{
  // The import pipeline and the maintenance scripts run under tsx as plain Node
  // ESM. They are not part of the Nuxt app and see none of its auto-imports, so
  // they get their own project rather than borrowing the app's.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    // `enrichment.ts` and `concordance-sources.ts` (below) type-only-import
    // from `#shared/types` — stripped entirely by tsx at runtime
    // (`verbatimModuleSyntax`), but the type checker still needs to resolve
    // it. Nuxt's own generated `#shared` alias (`.nuxt/tsconfig.shared.json`)
    // is not reachable here; this is the same mapping, relative to this file.
    "paths": {
      "#shared/*": ["./shared/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "drizzle.config.ts",
    "vitest.config.ts",
    // Reached from scripts/import/03-mirror-images.ts, which reuses the same
    // magic-byte detection the upload endpoint uses.
    "server/utils/uploads.ts",
    // Reached from scripts/strip-description-html.ts, which reuses the same
    // sanitizer the contribution endpoint validates descriptions through.
    "server/utils/sanitize.ts",
    // Reached from scripts/verify-concordances.ts — both are pure/dependency-
    // free (no Nitro auto-imports), the same requirement as the two above.
    "server/utils/enrichment.ts",
    "server/utils/concordance-sources.ts"
  ]
}
