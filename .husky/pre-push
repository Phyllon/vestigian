zero="0000000000000000000000000000000000000000"
red="$(printf '\033[0;31m')"
reset="$(printf '\033[0m')"

# Same filter as .github/workflows/changeset-check.yml's PR check, run here
# too since this repo mostly pushes straight to `main` rather than through a
# PR that check would ever see. Advisory only, on purpose — see
# .changeset/README.md: the bump level and summary are a judgment call
# Changesets deliberately asks a human for, not something a hook should guess
# or block on.
# git feeds four fields per line; only two are used here.
# shellcheck disable=SC2034
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    merge_base=$(git merge-base "$local_sha" origin/main 2>/dev/null) || merge_base=""
    range="${merge_base:-$local_sha}..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  changed_files=$(git diff --name-only "$range" 2>/dev/null)
  [ -z "$changed_files" ] && continue

  if echo "$changed_files" | grep -qvE '^(\.changeset/|\.github/|.*\.md$)'; then
    pending=$(find .changeset -maxdepth 1 -name '*.md' ! -name 'README.md' 2>/dev/null)
    if [ -z "$pending" ]; then
      printf '%b\n' "${red}pre-push: app code is changing with no pending changeset (.changeset/*.md).${reset}" >&2
      printf '%b\n' "${red}pre-push: run \`pnpm changeset\` if this release should bump the version — see .changeset/README.md.${reset}" >&2
    fi
  fi
done

echo "pre-push: running pnpm check before pushing..."
pnpm check

# Advisory, never blocking: osv.dev is a network call and an advisory against
# an unchanged lockfile is no reason to refuse a push that did not touch it.
# The full table is `pnpm scan:deps`.
if ! pnpm --silent scan:deps >/dev/null 2>&1; then
  printf '%b\n' "${red}pre-push: warning — scan:deps reported vulnerable dependencies (or osv.dev was unreachable). Run \`pnpm scan:deps\` for the list.${reset}" >&2
fi
