{
  // eslint.config.mjs runs as plain Node ESM, loaded by ESLint itself, and is
  // not part of the app, the server or the scripts. Without a project of its
  // own the editor checks it in an inferred one, which resolves `eslint` to an
  // automatically acquired `@types/eslint` instead of the types ESLint 10 ships
  // — two incompatible `Linter.Config` shapes meeting at `withNuxt(...)`.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["eslint.config.mjs", "eslint-plugins.d.ts"]
}
